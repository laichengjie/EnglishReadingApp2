<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnglishReadingApp.ChinesePinyinAlphabetPage"
             Title="汉语拼音字母表"
             BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <VerticalStackLayout Grid.Row="0" 
                             BackgroundColor="#FF6B6B" 
                             Padding="20,15"
                             Spacing="5">
            <Label Text="汉语拼音字母表" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label Text="点击任意拼音即可发音" 
                   FontSize="13" 
                   TextColor="White"
                   Opacity="0.9"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- 拼音内容区域 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="12">

                <!-- 连读按钮区域 -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5">
                    <Button Grid.Column="0"
                            Text="🔊 连读全部"
                            Clicked="OnReadAllClicked"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="42"
                            FontSize="13"/>
                    <Button Grid.Column="1"
                            Text="🔊 声母"
                            Clicked="OnReadInitialsClicked"
                            BackgroundColor="#3498DB"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="42"
                            FontSize="13"/>
                    <Button Grid.Column="2"
                            Text="🔊 韵母"
                            Clicked="OnReadFinalsClicked"
                            BackgroundColor="#9B59B6"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="42"
                            FontSize="13"/>
                </Grid>

                <!-- 声母表 -->
                <Frame CornerRadius="12"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="12"
                       Margin="0,3">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📖 声母表（23个）" 
                               FontSize="15" 
                               FontAttributes="Bold"
                               TextColor="#E74C3C"/>
                        <FlexLayout x:Name="InitialsFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 单韵母 -->
                <Frame CornerRadius="12"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="12"
                       Margin="0,3">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🎵 单韵母（6个）" 
                               FontSize="15" 
                               FontAttributes="Bold"
                               TextColor="#E67E22"/>
                        <FlexLayout x:Name="SingleVowelsFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 复韵母（合并为一个大组） -->
                <Frame CornerRadius="12"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="12"
                       Margin="0,3">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🌈 复韵母（18个）" 
                               FontSize="15" 
                               FontAttributes="Bold"
                               TextColor="#27AE60"/>
                        <!-- 使用一个 FlexLayout 显示所有复韵母 -->
                        <FlexLayout x:Name="CompoundVowelsFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 整体认读音节 -->
                <Frame CornerRadius="12"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="12"
                       Margin="0,3">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📚 整体认读音节（16个）" 
                               FontSize="15" 
                               FontAttributes="Bold"
                               TextColor="#16A085"/>
                        <FlexLayout x:Name="WholeSyllablesFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部状态栏 -->
        <VerticalStackLayout Grid.Row="2" 
                             BackgroundColor="#F0F0F0"
                             Padding="10"
                             Spacing="2">
            <Label x:Name="StatusLabel" 
                   Text="共 63 个拼音 | 点击即可发音" 
                   FontSize="12"
                   TextColor="#666"
                   HorizontalOptions="Center"/>
            <ActivityIndicator x:Name="LoadingIndicator" 
                               IsVisible="False" 
                               Color="#FF6B6B"
                               HorizontalOptions="Center"
                               HeightRequest="20"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>