<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnglishReadingApp.MainPage"
             Title="欢迎您">
    <!-- 渐变背景 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 背景 - 使用渐变 -->
            <VerticalStackLayout Grid.Row="0" 
                             BackgroundColor="#4A90D9">
            </VerticalStackLayout>

            <!-- 装饰圆圈1 -->
            <Ellipse Fill="#FFFFFF" 
                 Opacity="0.08"
                 WidthRequest="350" 
                 HeightRequest="350"
                 HorizontalOptions="Start" 
                 VerticalOptions="Start"
                 Margin="-150,-100,0,0"/>

            <!-- 装饰圆圈2 -->
            <Ellipse Fill="#FFFFFF" 
                 Opacity="0.06"
                 WidthRequest="250" 
                 HeightRequest="250"
                 HorizontalOptions="End" 
                 VerticalOptions="Center"
                 Margin="0,0,-100,50"/>

            <!-- 装饰圆圈3 -->
            <Ellipse Fill="#FFFFFF" 
                 Opacity="0.1"
                 WidthRequest="180" 
                 HeightRequest="180"
                 HorizontalOptions="Center" 
                 VerticalOptions="End"
                 Margin="0,0,0,-50"/>

            <!-- 主要内容 -->
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="20" 
                                 Padding="30,50"
                                 VerticalOptions="Center">

                    <!-- 图标 - 添加阴影 -->
                    <!--<Frame CornerRadius="60"
                       HeightRequest="130"
                       WidthRequest="130"
                       HorizontalOptions="Center"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="0">
                        <Label Text="📚" 
                           FontSize="65"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </Frame>-->

                    <!-- 应用名称 -->
                    <Label Text="学习乐园"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>

                    <!-- 英文副标题 -->
                    <Label Text="Learning Paradise"
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.85"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"
                       Margin="0,-5,0,0"/>

                    <!-- 励志语录轮播区 -->
                    <Frame CornerRadius="20"
                       BackgroundColor="White"
                       Opacity="0.95"
                       HasShadow="True"
                       Padding="20"
                       Margin="0,30,0,10">

                        <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center">

                            <!-- 上引号 -->
                            <Label Text="❝"
                               FontSize="28"
                               TextColor="#4A90D9"
                               Opacity="0.6"
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>

                            <!-- 励志语录 -->
                            <Label x:Name="QuoteLabel"
                               Text=""
                               FontSize="16"
                               TextColor="#2C3E50"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="10,0"/>

                            <!-- 下引号 -->
                            <Label Text="❞"
                               FontSize="28"
                               TextColor="#4A90D9"
                               Opacity="0.6"
                               HorizontalOptions="Center"
                               Margin="0,0,0,5"/>

                            <!-- 分隔线 -->
                            <BoxView HeightRequest="1"
                                 WidthRequest="60"
                                 Color="#4A90D9"
                                 Opacity="0.3"
                                 HorizontalOptions="Center"
                                 Margin="0,10,0,0"/>

                            <!-- 出处 -->
                            <Label x:Name="AuthorLabel"
                               Text=""
                               FontSize="12"
                               TextColor="#7F8C8D"
                               HorizontalOptions="Center"
                               FontAttributes="Italic"/>

                            <!-- 语录切换指示点 -->
                            <HorizontalStackLayout x:Name="DotContainer"
                                               Spacing="8"
                                               HorizontalOptions="Center"
                                               Margin="0,10,0,0">
                                <!-- 动态生成指示点 -->
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>

                    <!-- 励志格言小贴士 -->
                    <Label x:Name="DailyTipLabel"
                       Text=""
                       FontSize="12"
                       TextColor="White"
                       Opacity="0.7"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"/>

                    <!-- 开始按钮 - 带阴影效果 -->
                    <Frame CornerRadius="30"
                       HeightRequest="55"
                       WidthRequest="220"
                       HorizontalOptions="Center"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="0"
                       Margin="0,30,0,0">
                        <Button Text="开始体验"
                            TextColor="#4A90D9"
                            BackgroundColor="Transparent"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="30"
                            HeightRequest="55"
                            WidthRequest="220"
                            Clicked="OnStartClicked"/>
                    </Frame>

                    <!-- 底部提示 -->
                    <Label Text="每天进步一点点，做更好的自己"
                       FontSize="11"
                       TextColor="White"
                       Opacity="0.6"
                       HorizontalOptions="Center"
                       Margin="0,20,0,10"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </ContentPage>