<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnglishReadingApp.EnglishPage"
             Title="英语跟读练习">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="20"
            VerticalOptions="Center">

            <!-- 标题 -->
            <Label
                Text="英语跟读练习"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#2C3E50" />

            <!-- 当前要跟读的句子 -->
            <Frame
                BackgroundColor="#F0F3F8"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">
                <Label
                    x:Name="SentenceLabel"
                    Text="Hello, how are you?"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="#2C3E50" />
            </Frame>

            <!-- 示范发音按钮 -->
            <Button
                x:Name="SpeakButton"
                Text="🔊 听示范发音"
                FontSize="18"
                BackgroundColor="#3498DB"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="60"
                Clicked="OnSpeakClicked"
                HorizontalOptions="Fill" />

            <!-- 跟读录音按钮 -->
            <Button
                x:Name="RecordButton"
                Text="🎤 开始跟读"
                FontSize="18"
                BackgroundColor="#27AE60"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="60"
                Clicked="OnRecordClicked"
                HorizontalOptions="Fill" />

            <!-- 显示识别结果（你说的是什么） -->
            <Frame
                BackgroundColor="#FFF3E0"
                CornerRadius="10"
                Padding="15"
                IsVisible="False">
                <Label
                    x:Name="RecognizedTextLabel"
                    Text="等待跟读..."
                    FontSize="16"
                    TextColor="#E67E22"
                    HorizontalTextAlignment="Center" />
            </Frame>

            <!-- 评分结果显示 -->
            <Frame
                BackgroundColor="#E8F8F5"
                CornerRadius="10"
                Padding="15"
                IsVisible="False">
                <Label
                    x:Name="ScoreLabel"
                    Text=""
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#27AE60"
                    HorizontalTextAlignment="Center" />
            </Frame>

            <!-- 加载指示器（录音时显示） -->
            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="#3498DB"
                HorizontalOptions="Center" />

            <!-- 提示文本 -->
            <Label
                Text="提示：点击录音按钮后，请在4秒内朗读上面的句子"
                FontSize="12"
                TextColor="#7F8C8D"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>