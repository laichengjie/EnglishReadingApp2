<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnglishReadingApp.ChinesePinyinAlphabetPage"
             Title="汉语拼音字母表">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <VerticalStackLayout Grid.Row="0" 
                             BackgroundColor="#FF6B6B" 
                             Padding="20,15"
                             Spacing="5">
            <Label Text="汉语拼音字母表" 
                   FontSize="22" 
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label Text="点击任意拼音即可发音" 
                   FontSize="13" 
                   TextColor="White"
                   Opacity="0.9"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- 拼音内容区域 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15" Padding="15">

                <!-- 连读按钮 -->
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10">
                    <Button Text="🔊 连读全部"
                            Clicked="OnReadAllClicked"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="45"
                            FontSize="14"/>
                    <Button Text="🔊 连读声母"
                            Clicked="OnReadInitialsClicked"
                            BackgroundColor="#3498DB"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="45"
                            FontSize="14"/>
                    <Button Text="🔊 连读韵母"
                            Clicked="OnReadFinalsClicked"
                            BackgroundColor="#9B59B6"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="45"
                            FontSize="14"/>
                </HorizontalStackLayout>

                <!-- 声母表 -->
                <Frame CornerRadius="15"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="15"
                       Margin="0,5">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📖 声母表（23个）" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#E74C3C"/>
                        <FlexLayout x:Name="InitialsFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 单韵母 -->
                <Frame CornerRadius="15"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="15"
                       Margin="0,5">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🎵 单韵母（6个）" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#E67E22"/>
                        <FlexLayout x:Name="SingleVowelsFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 复韵母 -->
                <Frame CornerRadius="15"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="15"
                       Margin="0,5">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🌈 复韵母（8个）" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#27AE60"/>
                        <FlexLayout x:Name="CompoundVowelsFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 前鼻韵母 -->
                <Frame CornerRadius="15"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="15"
                       Margin="0,5">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="👃 前鼻韵母（5个）" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#2980B9"/>
                        <FlexLayout x:Name="FrontNasalFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 后鼻韵母 -->
                <Frame CornerRadius="15"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="15"
                       Margin="0,5">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="👅 后鼻韵母（4个）" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#8E44AD"/>
                        <FlexLayout x:Name="BackNasalFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 整体认读音节 -->
                <Frame CornerRadius="15"
                       BackgroundColor="White"
                       HasShadow="True"
                       Padding="15"
                       Margin="0,5">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📚 整体认读音节（16个）" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#16A085"/>
                        <FlexLayout x:Name="WholeSyllablesFlex" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start"
                                    AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部加载指示器 -->
        <ActivityIndicator Grid.Row="2" 
                           x:Name="LoadingIndicator" 
                           IsVisible="False" 
                           Color="#FF6B6B"
                           HorizontalOptions="Center"
                           Margin="0,5"/>
    </Grid>
</ContentPage>